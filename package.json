{
  "name": "grandpa-bob-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone-only agent harness: the browser tab is the only host; Node runs pass-through channels (telegram mailbox, storage bridge, STT)",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--dns-result-order=ipv4first tsx src/index.ts",
    "chrome": "node web/scripts/chrome.mjs",
    "build": "tsc && npm run build:web",
    "build:web": "npm --prefix web run build",
    "web:standalone": "node web/scripts/serve.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "make-seed": "WORKSPACE_DIR=\"${WORKSPACE_DIR:-$HOME/grandma-workspace}\" npm --prefix web run make-seed",
    "seed:publish": "tsx scripts/publish-seed.ts",
    "seed:ship": "tsx scripts/publish-seed.ts --pack",
    "start": "node --dns-result-order=ipv4first dist/src/index.js",
    "storage-server": "WORKSPACE_DIR=\"${WORKSPACE_DIR:-$HOME/grandma-workspace}\" node web/scripts/storage-server.mjs",
    "typecheck": "tsc --noEmit",
    "lint:specs": "tsx scripts/spec-lint.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test:standalone": "tsx scripts/web-standalone-test.ts",
    "test:ui": "npm --prefix ui run typecheck && npm --prefix ui run build",
    "test:ui-order": "tsx scripts/ui-order-test.ts",
    "test:spec-lint": "tsx scripts/spec-lint-test.ts",
    "test:tree": "tsx scripts/tree-serialize-test.ts",
    "test:seed-freshness": "tsx scripts/seed-freshness-test.ts",
    "test:runlog-tiers": "tsx scripts/runlog-tiers-test.ts",
    "test:runlog-boot": "tsx scripts/runlog-boot-test.ts",
    "test:read-runs-handle": "tsx scripts/read-runs-handle-test.ts",
    "test:runlog-retention": "tsx scripts/runlog-retention-test.ts",
    "test:web-restore": "tsx scripts/web-session-restore-test.ts",
    "test:memory-race": "tsx scripts/memory-race-test.ts",
    "test:telegram-text": "tsx scripts/telegram-text-test.ts",
    "test:telegram-audio": "tsx scripts/telegram-audio-test.ts",
    "test:telegram-bridge": "tsx scripts/telegram-bridge-test.ts",
    "test:emit-value": "tsx scripts/emit-value-test.ts",
    "test:csv": "tsx scripts/csv-test.ts",
    "test:read-json": "tsx scripts/read-json-test.ts",
    "test:shell": "tsx scripts/shell-sandbox-test.ts",
    "test:paths": "tsx scripts/path-shim-test.ts",
    "test:lease": "tsx scripts/host-lease-test.ts",
    "test:workspace-transfer": "tsx scripts/workspace-transfer-test.ts",
    "test:profiles": "tsx scripts/profiles-test.ts",
    "test:pattern-path": "tsx scripts/pattern-path-test.ts",
    "test:platform": "tsx scripts/platform-fs-test.ts",
    "test:models": "tsx scripts/model-config-test.ts",
    "test:sqlite": "tsx scripts/sqlite-tools-test.ts",
    "test:db-sync": "tsx scripts/db-sync-test.ts",
    "test:browser-sql-guard": "tsx scripts/browser-sql-guard-test.ts",
    "test:exa-browser-wire": "tsx scripts/exa-browser-wire-test.ts",
    "test:coreutils": "tsx scripts/coreutils-test.ts",
    "test:env": "tsx scripts/env-file-test.ts",
    "whisper:up": "sh -c 'set -a; . ./.env 2>/dev/null; set +a; exec vendor/whisper.cpp/build/bin/whisper-server --host 127.0.0.1 --port 8178 -m vendor/whisper.cpp/models/${WHISPER_MODEL:-ggml-base.bin}'",
    "ollama:up": "sh -c 'curl -sf http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && echo \"ollama already running at :11434\" || exec ollama serve'",
    "test:module-loader": "tsx scripts/module-loader-test.ts",
    "test:cdp": "tsx scripts/cdp-test.ts",
    "test:browser-tools": "tsx scripts/browser-tools-test.ts",
    "test:ui-describe": "tsx scripts/ui-describe-test.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "grammy": "^1.45.1",
    "grandma-kat": "file:../grandma-kat"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
