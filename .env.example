# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:replace-me
# Comma-separated numeric Telegram user IDs allowed to use the bot.
# Get yours by messaging @userinfobot. Everyone else is silently ignored.
ALLOWED_USER_IDS=123456789

# --- Telegram channel (src/index.ts) ---
# Loopback port the channel's mailbox API listens on (the web app's default).
# BOB_TELEGRAM_PORT=8091
# Browser origins allowed to call the channel API (comma-separated). Only
# these origins get CORS headers; the server itself always binds 127.0.0.1.
# BOB_APP_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Where the mailbox/bindings state lives (default ~/.grandpa-bob/telegram).
# BOB_STATE_DIR=/absolute/path

# --- Storage bridge (web/scripts/storage-server.mjs) ---
# Opt-in STT pass-through: BOB_STT=1 exposes POST /stt (raw audio in,
# transcript out) so the tab uses the desktop's whisper instead of
# downloading an in-tab model. Requires ffmpeg + WHISPER_URL below.
# BOB_STT=1

# --- LLM secrets ---
# API keys referenced by models.json via ${ENV_VAR} interpolation.
# Copy models.example.json to models.json and edit; the model config
# (baseURL, model name, transform, protocol) lives there, not here.
# Ollama cloud:
OLLAMA_API_KEY=replace-me
# Neuralwatt (OpenAI-compatible, https://portal.neuralwatt.com):
# NEURALWATT_API_KEY=sk-replace-me
# Hugging Face router:
# HF_TOKEN=hf_replace-me

# --- Speech to text ---
# Backend: "whisper" (whisper.cpp, default) or "sherpa" (sherpa-onnx HTTP server).
# STT_BACKEND=sherpa
# Spoken language for transcription: "en", "de", ... or "auto" for detection.
# Locking the language improves accuracy on short clips. Empty = server default.
# STT_LANGUAGE=en

# whisper.cpp server (HTTP /inference endpoint, multipart upload).
# Vulkan build is the default on this machine; on Android/Termux use a CPU build instead.
WHISPER_URL=http://127.0.0.1:8178
# Model file in vendor/whisper.cpp/models/ used by `npm run whisper:up`.
# Accuracy ladder (slower but better): tiny < base < small < medium < large-v3-turbo.
# WHISPER_MODEL=ggml-base.bin

# sherpa-onnx websocket server (ws://host:port; sends float32 samples, "Done" -> text)
# Faster than whisper on CPU; Zipformer streaming models work great on phones.
SHERPA_URL=ws://127.0.0.1:8178
# Example launch (streaming Zipformer, English, ~140MB on disk):
#   sherpa-onnx-online-websocket-server --port=8178 \
#     --tokens=./sherpa-onnx-streaming-zipformer-en-2023-06-26/tokens.txt \
#     --encoder=./sherpa-onnx-streaming-zipformer-en-2023-06-26/encoder-epoch-99-avg-1.onnx \
#     --decoder=./sherpa-onnx-streaming-zipformer-en-2023-06-26/decoder-epoch-99-avg-1.onnx \
#     --joiner=./sherpa-onnx-streaming-zipformer-en-2023-06-26/joiner-epoch-99-avg-1.onnx

# --- Workspace: sandboxed directory for all file tools; a git repo with auto-commit ---
# Relative paths resolve against the project dir; use an ABSOLUTE path outside the
# project (as below) to keep the workspace's git history fully separate.
WORKSPACE_DIR=/home/love/grandma-workspace

# --- SQL tools (sql_query read-only, sql_write read-write) ---
# Optional absolute path to a single SQLite database the SQL tools are LOCKED
# to. When set, the agent can only touch this one file and its `path` argument
# is ignored entirely. When unset, the agent can reach any .db inside the
# workspace (still sandboxed). sql_query is always read-only; sql_write is the
# explicit read-write tool.
# SQLITE_LOCK_PATH=/home/love/grandma-workspace/data.db

# --- Web search ---
# Exa Search API key for the exa_search tool (https://exa.ai — get a key at
# https://dashboard.exa.ai/api-keys). Optional: the bot starts without it, but
# the agent will get "web search not configured" if it tries to search.
# EXO_API_KEY=replace-me

# --- Command allowlist for the run_command tool (comma-separated base names) ---
# ALLOWED_COMMANDS=ls,cat,head,tail,wc,find,rg,grep,pwd,git,mkdir,touch,date,file,stat,du,df,diff,which,echo,sort,uniq,comms

# --- Tool-result context cap ---
# Max characters of a tool result shown to the model (the agent's context).
# Full results are always kept for tree logic and the run log; only what the
# model reads is capped, rows-aware for { rows: [...] } results. 0 disables.
# Default 4000. Raise it if the agent needs to read larger raw dumps.
# MAX_TOOL_RESULT_CHARS=4000
