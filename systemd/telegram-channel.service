# User service for the combined channel process (src/index.ts): app :8080 +
# storage bridge + telegram mailbox API on :8795. The bot only starts when a
# TELEGRAM_BOT_TOKEN is configured; voice transcription needs whisper.service
# running (npm run whisper:up).
[Unit]
Description=grandpa-bob channels (app, storage bridge, telegram park & forward)
After=default.target

[Service]
ExecStart=/usr/bin/env node --dns-result-order=ipv4first %h/grandpa-bob-bot/dist/src/index.js
WorkingDirectory=%h/grandpa-bob-bot
Environment=BOB_CHANNEL_PORT=8795
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
