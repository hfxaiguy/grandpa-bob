{
  "name": "grandpa-bob-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser target: grandpa-bob running entirely in a tab (OPFS + WASM SQLite, no backend).",
  "scripts": {
    "build": "vite build",
    "preview": "vite preview",
    "standalone": "node scripts/serve.mjs",
    "smoke": "node smoke.mjs",
    "smoke:direct": "node scripts/direct-smoke.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "smoke:profiles": "node scripts/profile-smoke.mjs",
    "smoke:seed-update": "node scripts/seed-update-smoke.mjs",
    "mock-llm": "node mock-llm.mjs",
    "make-seed": "node scripts/make-seed.mjs",
    "git-server": "node scripts/git-server.mjs",
    "storage-server": "WORKSPACE_DIR=\"${WORKSPACE_DIR:-$HOME/grandma-workspace}\" node scripts/storage-server.mjs",
    "typecheck": "tsc --noEmit",
    "smoke:lease": "node scripts/lease-smoke.mjs",
    "smoke:pairing": "node scripts/pairing-smoke.mjs",
    "smoke:pair-live": "node scripts/pair-smoke.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vite-plugin-solid": "^2.11.14"
  },
  "dependencies": {
    "@componentor/opfs-fs": "^1.1.7",
    "@huggingface/transformers": "^4.3.1",
    "@sqlite.org/sqlite-wasm": "^3.54.1-build1",
    "@supabase/supabase-js": "^2.58.0",
    "buffer": "^6.0.3",
    "isomorphic-git": "^1.42.6",
    "solid-js": "^1.9.17"
  }
}
